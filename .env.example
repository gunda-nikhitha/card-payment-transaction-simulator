# ==============================================================
# Environment Configuration Template
# Copy this file to .env and configure your secrets
# ==============================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/cpts_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=cpts_user
DB_PASSWORD=cpts_password
DB_POOL_SIZE=10

# Server & Security
PORT=8080
JWT_SECRET=use_a_very_long_random_string_at_least_64_bytes_for_hs512_cryptography
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Simulation Rules
SIM_MAX_AMOUNT=1000000.00
SIM_APPROVE_PROB=0.75
SIM_DECLINE_PROB=0.20
SIM_TIMEOUT_PROB=0.05
SIM_PROCESSING_DELAY=500

# AI / LLM Integration (Optional - Fallback works offline)
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo
AI_API_URL=https://api.openai.com/v1/chat/completions

# Frontend API URL (Used during frontend production build)
VITE_API_BASE_URL=
